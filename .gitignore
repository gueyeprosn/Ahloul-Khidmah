# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite data
/data
*.db
*.db-journal
*.db-shm
*.db-wal

# fichiers uploadés à l'exécution (produits, badges, témoignages) — données,
# pas du code ; grossissent avec le temps, pas destinés au dépôt
/public/uploads

# identifiants réels — ne doivent jamais entrer dans l'historique Git
/secrets
*.p12

# outils d'édition (Claude Code, Cursor) et leurs plugins/skills locaux —
# propres à la machine/session, pas au code du projet
/.claude
/.cursor
/.impeccable
