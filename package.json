{
  "name": "ahloul-khidma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "deploy": "bash deploy/deploy.sh",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
