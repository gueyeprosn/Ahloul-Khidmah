    "clsx": "^2.1.1",
    "file-type": "^22.0.2",
    "firebase-admin": "14.3.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
